# One line-ending policy, so a Windows checkout stops reporting every file as
# modified and diffs stay reviewable.
* text=auto eol=lf

# cmd.exe and PowerShell scripts want CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diffed, never re-encoded.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
